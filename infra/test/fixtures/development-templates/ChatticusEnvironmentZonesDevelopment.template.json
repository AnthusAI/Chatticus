{
  "Description": "Delegated Route 53 zones for the development environment's names.",
  "Resources": {
    "SiteZoneFF0EAA7C": {
      "Type": "AWS::Route53::HostedZone",
      "Properties": {
        "HostedZoneTags": [
          {
            "Key": "chatticus:application",
            "Value": "Chatticus"
          },
          {
            "Key": "chatticus:component",
            "Value": "dns"
          },
          {
            "Key": "chatticus:environment",
            "Value": "development"
          },
          {
            "Key": "chatticus:installation",
            "Value": "Test"
          }
        ],
        "Name": "develop.chattic.us."
      },
      "UpdateReplacePolicy": "Retain",
