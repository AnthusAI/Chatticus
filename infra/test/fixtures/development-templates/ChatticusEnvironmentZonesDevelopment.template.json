    },
    "AuthNameServers": {
      "Description": "Delegate auth-develop.chattic.us to these name servers from the management zone.",
      "Value": {
        "Fn::Join": [
          ",",
          {
            "Fn::GetAtt": [
              "AuthZone1B40937F",
              "NameServers"
            ]
          }
        ]
      }
    },
    "ExportsOutputRefSiteZoneFF0EAA7CF0B39F08": {
      "Value": {
        "Ref": "SiteZoneFF0EAA7C"
      },
      "Export": {
        "Name": "ChatticusEnvironmentZonesDevelopment:ExportsOutputRefSiteZoneFF0EAA7CF0B39F08"
      }
    },
    "ExportsOutputRefAuthZone1B40937F8A89DA59": {
      "Value": {
        "Ref": "AuthZone1B40937F"
      },
      "Export": {
        "Name": "ChatticusEnvironmentZonesDevelopment:ExportsOutputRefAuthZone1B40937F8A89DA59"
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
