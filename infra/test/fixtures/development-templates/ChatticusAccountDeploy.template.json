        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
                },
                "StringLike": {
                  "token.actions.githubusercontent.com:sub": "repo:*@152415604/*@1350947261:environment:development"
                }
              },
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcA2A496A3"
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "GitHub Actions OIDC deploy: development environment of this account.",
        "ManagedPolicyArns": [
          {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition"
                },
                ":iam::aws:policy/AdministratorAccess"
              ]
            ]
          }
        ],
        "RoleName": "chatticus-github-actions-deploy",
        "Tags": [
          {
            "Key": "chatticus:application",
            "Value": "Chatticus"
          },
          {
            "Key": "chatticus:component",
            "Value": "deploy"
          },
          {
            "Key": "chatticus:environment",
            "Value": "shared"
          },
          {
            "Key": "chatticus:installation",
            "Value": "Test"
          }
        ]
      }
    },
    "GithubActionsDeployDefaultPolicy4040E2E2": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "ecr:GetAuthorizationToken",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "EcrLoginToken"
            },
            {
              "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:DescribeImages",
                "ecr:DescribeRepositories",
                "ecr:GetDownloadUrlForLayer",
                "ecr:InitiateLayerUpload",
                "ecr:PutImage",
                "ecr:UploadLayerPart"
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition"
                    },
                    ":ecr:us-east-1:",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":repository/chatticuscomputers-computerimage*"
                  ]
                ]
              },
              "Sid": "ComputerImagePush"
            },
            {
              "Action": "cloudformation:DescribeStacks",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition"
                    },
                    ":cloudformation:us-east-1:",
                    {
                      "Ref": "AWS::AccountId"
                    },
                    ":stack/ChatticusComputers/*"
                  ]
                ]
              },
              "Sid": "ComputerStackOutputs"
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "GithubActionsDeployDefaultPolicy4040E2E2",
        "Roles": [
          {
            "Ref": "GithubActionsDeploy108F71AB"
          }
        ]
      }
    }
  },
  "Outputs": {
    "GithubDeployRoleArn": {
      "Description": "Environment secret AWS_DEPLOY_ROLE_ARN for the development GitHub environment, set only at cutover.",
      "Value": {
        "Fn::GetAtt": [
          "GithubActionsDeploy108F71AB",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "BootstrapVersion": {
      "Type": "AWS::SSM::Parameter::Value<String>",
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
