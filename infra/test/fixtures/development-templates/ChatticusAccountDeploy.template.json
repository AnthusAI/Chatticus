{
  "Description": "GitHub Actions OIDC provider and development deploy role for this environment account.",
  "Resources": {
    "GitHubOidcA2A496A3": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Tags": [
          {
            "Key": "chatticus:application",
            "Value": "Chatticus"
          },
          {
            "Key": "chatticus:component",
            "Value": "deploy"
          },
          {
            "Key": "chatticus:environment",
            "Value": "shared"
          },
          {
            "Key": "chatticus:installation",
            "Value": "Test"
          }
        ],
        "Url": "https://token.actions.githubusercontent.com"
      }
    },
    "GithubActionsDeploy108F71AB": {
      "Type": "AWS::IAM::Role",
