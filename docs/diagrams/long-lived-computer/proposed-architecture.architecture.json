 "cards": [
  {
   "dot": "emerald",
   "title": "Long-lived owner",
   "items": [
    "Polls Front Door: 10 s idle, 1 s busy, 0.5 s with a panel open",
    "Parked turns reach it with no new start",
    "Idles out after a timeout, then publishes and reports stopped"
   ]
  },
  {
   "dot": "cyan",
   "title": "Files",
   "items": [
    "Off: read the snapshot index and ranged bytes from S3",
    "On: a request item the owner picks up and runs through the unprivileged helper",
    "Edits carry a hash precondition and an audit record"
   ]
  },
  {
   "dot": "rose",
   "title": "Preview",
   "items": [
    "Separate origin, random host per session, no cookie",
    "Relay reaches only loopback of that organization's owner",
    "No WebSocket, no load balancer: reload on change"
   ]
  }
 ]
