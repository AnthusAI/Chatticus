  {
   "dot": "violet",
   "title": "Who owns the session",
   "items": [
    "Only the owner holding the highest fence can write the session.",
    "The Lambda holds fence 1 and the container takes a higher fence on takeover; the old owner can no longer commit.",
    "A recovered attempt invalidates the old container's gateway token."
   ]
  },
  {
   "dot": "amber",
   "title": "Limits",
   "items": [
    "A tool lost when an owner dies is reported to the model, not silently re-run.",
    "Scoped credentials and the gateway token last one hour with no refresh.",
    "A turn parked behind a live owner waits for it to exit."
   ]
  }
 ]
