 "cards": [
  {
   "dot": "violet",
   "title": "What happens",
   "items": [
    "The Lambda runs Pi until the first computer tool call, then parks the turn and publishes a start job.",
    "The starter mints a gateway token bound to a fresh owner id and assumes a scoped role.",
    "The owner claims the parked turn under that owner id, replays the call locally and finishes the turn."
   ]
  },
  {
   "dot": "rose",
   "title": "What the container cannot do",
   "items": [
    "It holds no OpenAI key; model calls go through the gateway with a token.",
    "Its task role is empty; its storage keys cover one session, one snapshot prefix and the organization's Messaging items.",
    "The shell runs as uid 2000 with a scrubbed environment and cannot read the owner's environment."
   ]
  },
  {
   "dot": "amber",
   "title": "Limits",
   "items": [
    "Rehearsed on development only; staging and production do not run this path.",
    "The container credentials endpoint cannot be blocked on Fargate; it is mitigated, not blocked.",
    "Customer-account computers never get Pi."
   ]
  }
 ]
}