  "cards": [
    {
      "dot": "violet",
      "title": "Who owns the session",
      "items": [
        "Only the owner holding the highest fence can write the session.",
        "For example, fence 1 belongs to the Lambda, fence 2 to the container and fence 3 to a Lambda again.",
        "Opening with a higher fence is what takes ownership; the old owner can no longer commit."
      ]
    },
    {
      "dot": "amber",
      "title": "Still open",
      "items": [
        "What triggers the handoff: the start of a turn or the first computer tool.",
