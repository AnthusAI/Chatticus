  "cards": [
    { "dot": "emerald", "title": "What happens in one turn", "items": [
      "A person sends a message. FrontDoor admits it and queues a job.",
      "The TurnExecutor Lambda opens the bot's Pi session and runs Pi there. It calls the model with the key from SSM.",
      "When the model asks for a computer tool, the Lambda records an action, parks the turn and ends.",
      "The container claims the action over HTTP, runs it on /workspace and posts the result.",
      "FrontDoor queues the turn again; a new Lambda owner resumes the session and Pi continues."
    ] },
    { "dot": "rose", "title": "Trust boundary", "items": [
      "The container runs commands the model chose.",
      "So it holds no Pi, no model key and no database access.",
      "It reaches the control plane only through the HTTP host routes."
    ] },
    { "dot": "amber", "title": "Words used here", "items": [
      "Session: a bot's saved conversation with Pi, stored in S3 and DynamoDB.",
      "Owner: the one process allowed to write the session. A fence number decides who.",
      "Park: end the Lambda while a tool runs elsewhere; the turn waits."
    ] }
  ]
}
