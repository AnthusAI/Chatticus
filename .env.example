# Environment variables for local development.
# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
CHATTICUS_BEDROCK_ENABLED=
CHATTICUS_DEFAULT_MODEL=
CHATTICUS_TENANT_ID=anthus
CHATTICUS_SNAPSHOT_STORE=./var/snapshot-store
# CDK output SnapshotBucketName from ChatticusSnapshots. Required for --store s3.
CHATTICUS_SNAPSHOT_BUCKET=
