{
  "name": "chatticus",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "infra",
    "conversation",
    "host-protocol",
    "computer/host"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "dev": "npm run dev --workspace=web",
    "synth": "npm run synth --workspace=infra",
    "moto:start": "docker run --rm -p 5555:5000 motoserver/moto:5.2.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": "15.5.24"
  },
  "exports": {
    "./components/ui/*": "./web/components/ui/*.tsx",
    "./components/BotAvatarView": "./web/components/BotAvatarView.tsx",
    "./components/workspace/WorkspacePanel": "./web/components/workspace/WorkspacePanel.tsx",
    "./components/workspace/WorkspaceRoster": "./web/components/workspace/WorkspaceRoster.tsx",
    "./components/workspace/WorkspaceThread": "./web/components/workspace/WorkspaceThread.tsx",
    "./components/workspace/types": "./web/components/workspace/types.ts",
    "./lib/utils": "./web/lib/utils.ts",
    "./lib/ogImage": "./web/lib/ogImage.tsx",
    "./styles/shared.css": "./web/styles/shared.css",
    "./tailwind-preset": "./web/tailwind-preset.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "anthus-vultus": "https://github.com/AnthusAI/Vultus/archive/a3b6fd17341af58bb2d517b1ccf4385f19d28f72.tar.gz",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "25.0.9"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
