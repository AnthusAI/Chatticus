{
  "name": "chatticus",
  "version": "0.51.0",
  "private": true,
  "workspaces": [
    "web",
    "infra",
    "conversation",
    "host-protocol",
    "computer/host"
  ],
  "scripts": {
    "build": "node chat/build-runtime.mjs && npm run build --workspaces --if-present",
    "build:chat-runtime": "node chat/build-runtime.mjs",
    "prepack": "npm run build:chat-runtime",
    "test:chat-runtime-package": "node chat/test-runtime-package.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "dev": "npm run dev --workspace=web",
    "synth": "npm run synth --workspace=infra",
    "moto:start": "docker run --rm -p 5555:5000 motoserver/moto:5.2.3",
    "build:chat-styles": "node chat/build-styles.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": "15.5.24"
  },
  "exports": {
    "./components/ui/*": "./web/components/ui/*.tsx",
    "./components/BotAvatarView": "./web/components/BotAvatarView.tsx",
    "./components/workspace/WorkspacePanel": "./web/components/workspace/WorkspacePanel.tsx",
    "./components/workspace/WorkspaceRoster": "./web/components/workspace/WorkspaceRoster.tsx",
    "./components/workspace/WorkspaceThread": "./web/components/workspace/WorkspaceThread.tsx",
    "./components/workspace/types": "./web/components/workspace/types.ts",
    "./lib/utils": "./web/lib/utils.ts",
    "./lib/ogImage": "./web/lib/ogImage.tsx",
    "./styles/shared.css": "./web/styles/shared.css",
    "./tailwind-preset": "./web/tailwind-preset.ts",
    "./chat-client": "./chat/client/index.ts",
    "./chat-server": {
      "types": "./chat/runtime-dist/chat-server.d.ts",
      "import": "./chat/runtime-dist/chat-server.mjs",
      "default": "./chat/runtime-dist/chat-server.mjs"
    },
    "./chat-worker": {
      "types": "./chat/runtime-dist/chat-worker.d.ts",
      "import": "./chat/runtime-dist/chat-worker.mjs",
      "default": "./chat/runtime-dist/chat-worker.mjs"
    },
    "./chat-runtime": {
      "types": "./chat/runtime-dist/chat-runtime.d.ts",
      "import": "./chat/runtime-dist/chat-runtime.mjs",
      "default": "./chat/runtime-dist/chat-runtime.mjs"
    },
    "./chat-react": "./chat/react/index.ts",
    "./chat.css": "./chat/styles.css"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-sqs": "3.1146.0",
    "@aws-sdk/client-ssm": "3.1146.0",
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/signature-v4": "3.374.0",
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@smithy/protocol-http": "3.3.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "anthus-vultus": "https://github.com/AnthusAI/Vultus/archive/a3b6fd17341af58bb2d517b1ccf4385f19d28f72.tar.gz",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.6.0",
    "hono": "4.13.13",
    "aws-jwt-verify": "5.2.1",
    "zod": "4.6.5",
    "@assistant-ui/react": "0.15.19",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
